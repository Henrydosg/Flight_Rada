{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flight Radar: build IDF 5.5.2 (no flash)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "${workspaceFolder}/tools/build_waveshare7.ps1",
        "-BuildDirectory",
        "build-baseline"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}